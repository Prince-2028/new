{
  "name": "smartapp-desktop",
  "version": "1.0.0",
  "description": "Electron wrapper for SmartApp (uses existing build folder)",
  "main": "main.js",
  "author": "Your Name",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "icon": "build/favicon.ico",
    "appId": "aviconn.smartapp.desktop",
    "productName": "SmartApp",
    "electronLanguages": [
      "en-US"
    ],
    "files": [
      "build/**/*",
      "main.js",
      "package.json",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "backend/SmartAppBackend.exe",
        "to": "backend/SmartAppBackend.exe",
        "filter": [
          "**/*"
        ]
      }
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "build/favicon.ico",
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SmartApp",
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": true
    }
  }
}